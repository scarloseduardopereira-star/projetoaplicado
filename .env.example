# Copie para .env e preencha. O .env real NUNCA vai para o Git.

# development (HTTP local) ou production (atrás do Nginx/HTTPS)
APP_ENV=development

# Chave de sessão. Gere uma aleatória, ex.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Usuário de login
APP_USER=admin

# Hash Argon2 da senha. Gere com: python generate_hash.py
APP_PASSWORD_HASH=cole-o-hash-argon2-aqui
